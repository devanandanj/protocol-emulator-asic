; Exercises the 0xF extended group. Not a protocol: test_protocols runs it to
; compare the RTL with the model cycle-for-cycle, including the two-cycle
; synchronizer delay on pin 3 for IN, WAIT and SKP.

        in    3, r4             ; pin 3 rises before cycle 2 ...
        in    3, r5
        in    3, r6
        in    3, r7             ; ... and only this read sees it
        ldi   r0, 0x5A
        ldi   r1, 0x0F
        xor   r0, r1            ; 0x55
        and   r0, r1            ; 0x05
        or    r0, r1            ; 0x0F
        add   r0, r1            ; 0x1E
        ldi   r2, 0xFF
        ldi   r3, 2
        add   r2, r3            ; wraps to 1
        skeq  r0, r1            ; not equal: no skip
        ldi   r4, 1
        skeq  r1, r1            ; equal: skip
        ldi   r4, 2
wait_hi:
        skp   3, 1              ; leave the loop once pin 3 is high
        jmp   wait_hi
        ldi   r5, 0x0A
wait_lo:
        skp   3, 0              ; leave the loop once pin 3 is low
        jmp   wait_lo
        ldi   r6, 0x0B
        wait  3, 1, 0           ; exit timing shows the same delay
        ldi   r6, 0x0C
        delay 10
        wait  3, 0, 0           ; pin 3 falls on this cycle: still seen high
        ldi   r6, 0x0D
done:
        jmp   done
